# Copy this file to .env and fill in your keys

# Required — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Required — get yours at https://newsapi.org (free dev tier: 100 req/day)
NEWS_API_KEY=

# Required for account deletion (Settings > Delete Account).
# Project Settings > API in the Supabase dashboard. The service role key
# bypasses RLS — keep it server-side only, never ship it in the app.
SUPABASE_URL=https://uvkrnjpbrtekdeslvdwn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional — enables posting trend cards to X (Twitter). Create an app at
# https://developer.x.com with Read+Write permissions and generate an access
# token/secret for the account that should post. Posting is skipped (with a
# startup warning) if any of these are unset.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Optional — enables posting the same trend card to Instagram (@whyrlnews) as
# a generated image. Requires the account to be a Business/Creator account
# linked to a Facebook Page, a Meta developer app with the Instagram Graph
# API product, and a Page access token. IG_BUSINESS_ACCOUNT_ID is the linked
# Instagram account's id (not the Facebook Page id). Posting is skipped (with
# a startup warning) if either is unset.
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Optional — enables posting the same generated image to the Whyrl Facebook
# Page. Uses the same System User token pattern as Instagram (Meta Business
# Suite > Users > System users), but that token needs the pages_manage_posts
# permission added, since the Instagram-only token above doesn't include it.
# FB_PAGE_ID is the numeric Facebook Page id (Business Settings > Accounts >
# Pages > Whyrl). Posting is skipped (with a startup warning) if either is
# unset.
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=

# Base URL this server is publicly reachable at — used to build the
# fetchable image_url Instagram's API needs (it fetches by URL, no direct
# upload). Defaults to the production Railway domain if unset.
PUBLIC_BASE_URL=https://whyrl-production.up.railway.app

# Server config
PORT=3001
NODE_ENV=development
